---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowDown, ArrowRight, ArrowUpRight, BookOpen, Code2, Cpu, Layers3, Network, ShieldCheck } from '@lucide/astro';
import '../styles/home.css';

const research = [
  {
    number: '01', label: 'Intent & agent systems', title: 'PIPER',
    description: 'Connecting intent to task contracts, evidence requirements, and workflow guards. The current Hermes advisory plugin explores one part of a broader architecture.',
    href: '/resume-research#piper', link: 'Explore PIPER', Icon: Network, tone: 'cyan',
    terms: ['Intent', 'Contracts', 'Evidence']
  },
  {
    number: '02', label: 'Compute & inference', title: 'Beyond model serving',
    description: 'NVFP4 model conversion, vLLM deployment, and workload-specific tuning. Performance research grounded in reproducible tests and explicit limits.',
    href: '/resume-research#inference', link: 'Inside inference engineering', Icon: Cpu, tone: 'blue',
    terms: ['CUDA', 'NVFP4', 'vLLM']
  },
  {
    number: '03', label: 'Research & evidence', title: 'Can the result be trusted?',
    description: 'Self-hosted AI-Q research workflows, source traceability, and replayable evaluation. Investigating what changes as evidence moves between agents.',
    href: '/resume-research#ai-q', link: 'Read the research', Icon: BookOpen, tone: 'green',
    terms: ['Sources', 'Evaluation', 'Replay']
  }
];
---

<BaseLayout
  title="TechSoft Systems | Independent AI Research & Engineering"
  description="From infrastructure to intelligence. Independent research in GPU inference, agent systems, evidence integrity, and the infrastructure that makes them reliable."
  fullWidth
>
  <div class="homepage">
    <section class="home-hero" aria-labelledby="hero-title">
      <img class="hero-mark" src="/branding/hero-mark.png" width="1024" height="1024" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="site-width hero-content">
        <p class="eyebrow hero-eyebrow"><span aria-hidden="true"></span> Independent AI Research &amp; Engineering</p>
        <h1 id="hero-title">TechSoft<br /><span>Systems.</span></h1>
        <p class="hero-signature">From infrastructure to intelligence.</p>
        <p class="hero-description">Building, testing, and understanding AI systems.<br class="desktop-break" /> From the GPU stack to the agents that run on it.</p>
        <div class="home-actions">
          <a class="home-button primary" href="#research">Explore the research <ArrowDown size={18} aria-hidden="true" /></a>
          <a class="home-button secondary" href="/open-source">Open source <ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
        <div class="hero-footnote"><span>Tucson, Arizona</span><span>Independent by design.</span></div>
      </div>
    </section>

    <section class="research-band" id="research" aria-labelledby="research-title">
      <div class="site-width">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Inside the lab</p>
            <h2 id="research-title">Real systems.<br />Questions worth testing.</h2>
          </div>
          <div class="section-intro">
            <p>Independent applied research in inference, agent behavior, and evidence. Built hands-on, with the methods and limitations kept in view.</p>
            <a class="text-link" href="/resume-research">All research <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
        <div class="research-grid">
          {research.map(item => (
            <article class={`research-item tone-${item.tone}`}>
              <div class="research-item-top"><item.Icon size={28} strokeWidth={1.5} aria-hidden="true" /><span>{item.number}</span></div>
              <div class="research-terms" aria-hidden="true">{item.terms.map(term => <span>{term}</span>)}</div>
              <p class="eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p class="research-description">{item.description}</p>
              <a class="text-link" href={item.href}>{item.link}<ArrowUpRight size={17} aria-hidden="true" /></a>
            </article>
          ))}
        </div>
        <a class="memory-link" href="/resume-research#memory"><Layers3 size={20} aria-hidden="true" /><span>Also in the lab: <strong>memory provenance and human-reviewed proposals.</strong></span><ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="essay-band" aria-labelledby="essay-title">
      <div class="site-width essay-layout">
        <a class="essay-art" href="/defiantly_not_regex/" aria-label="Read Defiantly Not Regex">
          <img src="/defiantly_not_regex/defiantly_not_regex_b64_ocrsafe_3000.png" width="3000" height="3000" loading="lazy" alt="Defiantly Not Regex. Parse carefully. Humans are not strings." />
          <span>Defiantly Not Regex <ArrowUpRight size={18} aria-hidden="true" /></span>
        </a>
        <div class="essay-copy">
          <p class="eyebrow">An idea from the lab</p>
          <h2 id="essay-title">Meaning is not<br />the same as structure.</h2>
          <p>A visual thesis born from working with models and harnesses. What happens when valid syntax is mistaken for understanding, and what should an intent layer actually do?</p>
          <div class="essay-links">
            <a class="text-link" href="/defiantly_not_regex/">Explore the thesis <ArrowUpRight size={17} aria-hidden="true" /></a>
            <a class="quiet-link" href="/defiantly_not_regex/pages/whitepaper.html">Read the whitepaper</a>
          </div>
        </div>
      </div>
    </section>

    <section class="practice-band" aria-labelledby="practice-title">
      <div class="site-width practice-layout">
        <div>
          <p class="eyebrow">Research meets practice</p>
          <h2 id="practice-title">Built on an infrastructure foundation.</h2>
          <p class="practice-lead">TechSoft Systems is led by Johnathan W. Carroll. More than 25 years across enterprise IT, government, ISP operations, and entrepreneurship inform the questions explored in the lab.</p>
          <a class="text-link" href="/resume">Experience &amp; background <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
        <div class="practice-list">
          <a href="/services"><Network size={24} aria-hidden="true" /><div><h3>Infrastructure &amp; private AI</h3><p>Architecture, resilient platforms, and AI workloads.</p></div><ArrowUpRight size={20} aria-hidden="true" /></a>
          <a href="/services"><ShieldCheck size={24} aria-hidden="true" /><div><h3>Security &amp; reliability</h3><p>Governance, operational visibility, and recovery.</p></div><ArrowUpRight size={20} aria-hidden="true" /></a>
          <a href="/training"><BookOpen size={24} aria-hidden="true" /><div><h3>Training &amp; enablement</h3><p>Practical AI knowledge for teams and leaders.</p></div><ArrowUpRight size={20} aria-hidden="true" /></a>
          <a href="/open-source"><Code2 size={24} aria-hidden="true" /><div><h3>Open-source work</h3><p>Public projects, integrations, and contributions.</p></div><ArrowUpRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="contact-band" aria-labelledby="contact-title">
      <div class="site-width contact-layout">
        <div><p class="eyebrow">Research. Engineering. Real-world questions.</p><h2 id="contact-title">Let's build on what comes next.</h2></div>
        <a class="home-button primary" href="/contact">Start a conversation <ArrowUpRight size={19} aria-hidden="true" /></a>
      </div>
    </section>
  </div>
</BaseLayout>
