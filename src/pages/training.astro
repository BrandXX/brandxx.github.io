---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeCard from '../components/PracticeCard.astro';
import { ArrowRight, BookOpen, CalendarDays, Code, Compass, Mail, Presentation, ShieldCheck, Users } from '@lucide/astro';
import '../styles/practice.css';
---

<BaseLayout
  title="Training | TechSoft Systems"
  description="Hands-on AI training programs for IT teams, business users, and leaders with measurable outcomes."
  fullWidth
>
  <div class="practice-page">
    <header class="practice-intro site-width">
      <h1>AI Training & Enablement</h1>
      <p>AI training programs built for practical adoption: technical depth for builders, safe workflows for users, and governance clarity for leaders.</p>
    </header>

    <div class="site-width practice-grid practice-grid-three practice-opening">
      <PracticeCard eyebrow="Audience" title="IT teams">
        <Code slot="icon" size={28} strokeWidth={1.5} />
        <ul class="practice-list">
          <li>Private AI architecture patterns for on-prem and hybrid workloads</li>
          <li>Containerized model serving, RAG systems, and performance tuning</li>
          <li>Observability, access controls, retention, and audit readiness</li>
        </ul>
      </PracticeCard>
      <PracticeCard eyebrow="Audience" title="Business users">
        <Users slot="icon" size={28} strokeWidth={1.5} />
        <ul class="practice-list">
          <li>Prompting patterns for real business workflows</li>
          <li>Verification methods to reduce hallucination risk</li>
          <li>Sensitive data handling and escalation rules</li>
        </ul>
      </PracticeCard>
      <PracticeCard eyebrow="Audience" title="Leaders">
        <Compass slot="icon" size={28} strokeWidth={1.5} />
        <ul class="practice-list">
          <li>Use-case triage and risk-tier framework</li>
          <li>Governance model and rollout sequencing</li>
          <li>Success metrics for adoption, quality, and risk posture</li>
        </ul>
      </PracticeCard>
    </div>

    <section class="practice-section practice-band">
      <div class="site-width">
      <div class="practice-section-heading"><h2>Formats</h2><p>Select the delivery model that fits your team and compliance posture.</p></div>
      <div class="practice-grid">
        <PracticeCard heading="h3" title="Workshop (2-4 hours)" description="Focused, role-specific training for executive teams, business users, or IT operators."><Presentation slot="icon" size={28} strokeWidth={1.5} /></PracticeCard>
        <PracticeCard heading="h3" title="Bootcamp (1-2 days)" description="Hands-on lab sessions using practical architecture and policy scenarios."><BookOpen slot="icon" size={28} strokeWidth={1.5} /></PracticeCard>
        <PracticeCard heading="h3" title="Cohort (4-6 weeks)" description="Weekly sessions, office hours, and implementation reviews between modules."><CalendarDays slot="icon" size={28} strokeWidth={1.5} /></PracticeCard>
        <PracticeCard heading="h3" title="Custom regulated program" description="Policy-first enablement for healthcare, government, and compliance-constrained organizations."><ShieldCheck slot="icon" size={28} strokeWidth={1.5} /></PracticeCard>
      </div>
      </div>
    </section>

    <section class="site-width practice-section">
      <div class="practice-section-heading"><h2>Outcomes</h2><p>Every engagement targets concrete outputs your team can use immediately.</p></div>
      <div class="practice-outcomes">
        <div>
          <h3>Deliverables</h3>
          <ul class="practice-list">
            <li>Hands-on lab workbook and architecture diagrams</li>
            <li>Internal AI usage guidelines and policy cheat-sheet</li>
            <li>Approved workflows playbook</li>
            <li>Metrics template for adoption, risk, and productivity tracking</li>
          </ul>
        </div>
        <div>
          <h3>Sample 1-day bootcamp agenda</h3>
          <ol class="practice-agenda">
            <li>09:00 - 09:45 Private AI architecture foundations</li>
            <li>09:45 - 10:45 Lab: containerized inference pipeline</li>
            <li>11:00 - 12:00 Security boundaries and governance controls</li>
            <li>13:00 - 14:00 RAG patterns and data handling guardrails</li>
            <li>14:15 - 15:15 Observability and incident response practices</li>
            <li>15:30 - 16:30 Team workflow design and implementation checklist</li>
            <li>16:30 - 17:00 Action plan, ownership mapping, and next steps</li>
          </ol>
        </div>
      </div>
    <div class="practice-actions">
      <a
        href="mailto:sales@techsoftsys.com?subject=AI%20Training%20Inquiry"
        class="practice-button practice-primary"
      >
        <Mail size={18} aria-hidden="true" />Request training details
      </a>
      <a
        href="/contact"
        class="practice-button"
      >
        Talk through goals<ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
    </section>

    <section class="practice-callout"><div class="site-width practice-review">
      <h2>Training fit call</h2>
      <p>
        Schedule a short fit call to align audience, format, and outcomes before selecting a workshop, bootcamp, or cohort plan.
      </p>
      <div class="practice-actions">
        <a
          href="mailto:sales@techsoftsys.com?subject=Training%20Fit%20Call%20Request"
          class="practice-button practice-primary"
        >
          <Mail size={18} aria-hidden="true" />Request training fit call
        </a>
        <a
          href="/services"
          class="practice-button"
        >
          Compare service options<ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div></section>
  </div>
</BaseLayout>
