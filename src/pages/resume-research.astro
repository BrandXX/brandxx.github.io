---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import { projects, benchmarks, researchProfile, residencyMeasurements, inferenceEngineering } from '../data/publicResume';
---
<ResumeLayout title="AI Research | Johnathan W. Carroll" description="Independent AI infrastructure, LLMOps, GPU residency, agent audio integration, and reproducible research by Johnathan W. Carroll.">
  <header class="research-heading">
    <a class="back-link" href="/resume/">&larr; Johnathan W. Carroll</a>
    <h1>{researchProfile.title}</h1>
    <p>{researchProfile.summary}</p>
    <nav class="project-nav" aria-label="Research projects">
      {projects.map(project => <a href={`#${project.id}`}>{project.title}</a>)}
      <a href="#inference">Inference engineering</a>
    </nav>
  </header>
  {projects.map(project => (
    <section id={project.id} class="resume-section research-section">
      <p class="research-focus">{project.focus}</p>
      <h2>{project.title}</h2>
      <p class="research-status">{project.status}</p>
      <p>{project.summary}</p>
      <ul>{project.details.map(detail => <li>{detail}</li>)}</ul>
      {project.id === 'residency' && <>
        <h3>Selected Residency Measurements</h3>
        <div class="benchmark-list">
          {residencyMeasurements.map(measurement => <article><h4>{measurement.title}</h4><p class="benchmark-result">{measurement.result}</p><p>{measurement.method}</p></article>)}
        </div>
      </>}
      <p class="claim-boundary">{project.boundary}</p>
    </section>
  ))}
  <section id="inference" class="resume-section research-section">
    <p class="research-focus">{inferenceEngineering.focus}</p>
    <h2>{inferenceEngineering.title}</h2>
    <p class="research-status">{inferenceEngineering.status}</p>
    {inferenceEngineering.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    <ul>{inferenceEngineering.details.map(detail => <li>{detail}</li>)}</ul>
    <h3>Selected Local Measurements</h3>
    <div class="benchmark-list">
      {benchmarks.map(benchmark => <article><h4>{benchmark.model}</h4><p class="benchmark-result">{benchmark.result}</p><p>{benchmark.method}</p></article>)}
    </div>
    <p class="claim-boundary">{inferenceEngineering.boundary}</p>
  </section>
</ResumeLayout>
