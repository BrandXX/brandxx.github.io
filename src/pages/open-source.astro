---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeCard from '../components/PracticeCard.astro';
import { ArrowUpRight, Code, GitPullRequest, Network } from '@lucide/astro';
import '../styles/practice.css';
---

<BaseLayout
  title="Open Source | TechSoft Systems"
  description="Open-source contributions, internal tooling extracts, and demo projects from TechSoft Systems."
  fullWidth
>
  <div class="practice-page">
    <header class="practice-intro site-width">
      <h1>Open source</h1>
      <p>Public contributions, sanitized internal tooling extracts, and demo projects that can link directly to GitHub.</p>
    </header>

    <div class="site-width practice-grid practice-grid-three practice-opening">
      <PracticeCard
        title="Open-WebUI Contributions"
        description="Fork and contribution work around Open-WebUI deployment, integration, and secure private AI workflows."
      >
        <GitPullRequest slot="icon" size={28} strokeWidth={1.5} />
        <a href="https://github.com/BrandXX/open-webui" target="_blank" rel="noreferrer" class="practice-repository-link"><span>github.com/BrandXX/open-webui</span><ArrowUpRight size={18} aria-hidden="true" /></a>
      </PracticeCard>
      <PracticeCard
        title="MCP Server Platform"
        description="Model Context Protocol server platform for tooling integrations and controlled workflow orchestration."
      >
        <Network slot="icon" size={28} strokeWidth={1.5} />
        <a href="https://github.com/BrandXX/mcp-server-platform" target="_blank" rel="noreferrer" class="practice-repository-link"><span>github.com/BrandXX/mcp-server-platform</span><ArrowUpRight size={18} aria-hidden="true" /></a>
      </PracticeCard>
      <PracticeCard
        title="Private AI Demo Repositories"
        description="Public demo repositories for private inference pipelines and observability patterns with reproducible setup notes."
      >
        <Code slot="icon" size={28} strokeWidth={1.5} />
        <p class="practice-project-note">Additional repositories added on a rolling basis</p>
      </PracticeCard>
    </div>
  </div>
</BaseLayout>
