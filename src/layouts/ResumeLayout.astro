---
import '../styles/resume.css';
interface Props { title: string; description: string; print?: boolean; }
const { title, description, print = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(`${currentPath}/`, Astro.site);
const documentName = currentPath === '/resume-research' ? 'Research' : 'Resume';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#09090b" />
    <link rel="stylesheet" href="/resume-navigation.css" />
    {print && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch { document.documentElement.classList.remove('dark'); }
    </script>
  </head>
  <body class:list={{ 'print-document': print }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="document-shell">
    <header class="resume-nav">
      <a class="site-brand" href="/" aria-label="TechSoft Systems home">
        <img src="/logo-mark.svg" width="32" height="32" alt="" />
        <span>TechSoft Systems <span class="brand-document">&middot; {documentName}</span></span>
      </a>
      <nav aria-label="Resume navigation">
        <div class="document-nav">
          <a class="document-nav-link" href="/resume/" aria-current={currentPath === '/resume' || print ? 'page' : undefined}>Resume</a>
          <a class="document-nav-link" href="/cover-letter.html">Cover Letter</a>
          <a class="document-nav-link" href="/resume-research" aria-current={currentPath === '/resume-research' ? 'page' : undefined}>Research</a>
        </div>
        <div class="resume-actions">
        <button class="icon-button" id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
          <svg width="18" height="18" aria-hidden="true"><use href="/resume-icons.svg#sun" /></svg>
        </button>
        <button class="icon-button" id="print-resume" type="button" aria-label="Print resume" title="Print resume">
          <svg width="18" height="18" aria-hidden="true"><use href="/resume-icons.svg#printer" /></svg>
        </button>
        <a class="download-button" href="/pdfs/johnathan-carroll-resume.pdf" download>
          <svg width="18" height="18" aria-hidden="true"><use href="/resume-icons.svg#download" /></svg>
          <span>Download PDF</span>
        </a>
        </div>
      </nav>
    </header>
    <main id="main" class="resume-shell"><slot /></main>
    <footer class="resume-footer">
      <a href="/">TechSoft Systems</a><span>Tucson, Arizona</span>
      <a href="mailto:j.carroll@techsoftsys.com">j.carroll@techsoftsys.com</a>
    </footer>
    </div>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateThemeButton = () => {
        const dark = document.documentElement.classList.contains('dark');
        themeButton?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        themeButton?.setAttribute('title', dark ? 'Switch to light theme' : 'Switch to dark theme');
        const icon = themeButton?.querySelector('use');
        icon?.setAttribute('href', dark ? '/resume-icons.svg#sun' : '/resume-icons.svg#moon');
      };
      updateThemeButton();
      themeButton?.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch { /* Theme still works without persistent storage. */ }
        updateThemeButton();
      });
      document.querySelector('#print-resume')?.addEventListener('click', () => {
        if (document.body.classList.contains('print-document')) window.print();
        else window.location.assign('/resume-print');
      });
    </script>
  </body>
</html>
