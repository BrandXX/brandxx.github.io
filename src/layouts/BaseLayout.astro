---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '../styles/brand.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  fullWidth?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  ogImage = SITE.ogImage,
  noindex = false,
  fullWidth = false
} = Astro.props;

const resolvedTitle = title.includes('|')
  ? title
  : SITE.titleTemplate.replace('%s', title);

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="theme-color" content="#061624" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/branding/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/branding/apple-touch-icon.png" />
    <link rel="manifest" href="/branding/site.webmanifest" />
    <script is:inline>
      (() => {
        let savedTheme;
        try { savedTheme = localStorage.getItem('theme'); } catch { /* System preference works without storage. */ }
        const dark = savedTheme === 'dark' || (savedTheme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#061624' : '#f6faff');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar currentPath={Astro.url.pathname} />

    <main id="main-content" tabindex="-1" class:list={[!fullWidth && 'site-content relative mx-auto max-w-6xl px-6 pb-20']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
