---
import { ArrowUpRight, ChevronDown, Menu, Moon, Sun, X } from '@lucide/astro';

interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const primary = [
  { href: '/resume-research', label: 'Research' },
  { href: '/ai-lab', label: 'AI Lab' },
  { href: '/open-source', label: 'Open Source' },
  { href: '/services', label: 'Services' }
];
const more = [
  { href: '/work', label: 'Selected work' },
  { href: '/training', label: 'Training' },
  { href: '/about', label: 'About TechSoft' },
  { href: '/resume', label: 'Johnathan Carroll / Resume' },
  { href: '/defiantly_not_regex/', label: 'Defiantly Not Regex' }
];
const active = (href: string) => currentPath.replace(/\/$/, '') === href.replace(/\/$/, '') || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="site-width header-row">
    <a class="site-brand" href="/" aria-label="TechSoft Systems home">
      <img class="brand-on-light" src="/branding/logo-header-light.svg" width="400" height="86" alt="TechSoft Systems" />
      <img class="brand-on-dark" src="/branding/logo-header-dark.svg" width="400" height="86" alt="" aria-hidden="true" />
    </a>
    <nav class="desktop-navigation" aria-label="Main navigation">
      {primary.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <details class="nav-more" data-nav-details>
        <summary class:list={[more.some(link => active(link.href)) && 'has-active-page']}>More <ChevronDown size={14} aria-hidden="true" /></summary>
        <div class="nav-dropdown">
          {more.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
        </div>
      </details>
    </nav>
    <div class="header-actions">
      <button id="themeBtn" class="icon-button theme-button" type="button" aria-label="Switch color theme" title="Switch color theme">
        <Moon class="brand-on-light" size={19} aria-hidden="true" />
        <Sun class="brand-on-dark" size={19} aria-hidden="true" />
        <span class="button-tooltip" data-theme-label>Switch color theme</span>
      </button>
      <a class="header-contact" href="/contact">Get in touch <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <details class="mobile-navigation" data-nav-details>
      <summary class="icon-button" aria-label="Open navigation" title="Navigation">
        <Menu class="menu-open-icon" size={22} aria-hidden="true" />
        <X class="menu-close-icon" size={22} aria-hidden="true" />
      </summary>
      <nav aria-label="Mobile navigation">
        {[...primary, ...more, { href: '/contact', label: 'Get in touch' }].map(link =>
          <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}<ArrowUpRight size={16} aria-hidden="true" /></a>
        )}
      </nav>
    </details>
  </div>
</header>

<script>
  const button = document.getElementById('themeBtn');
  const preference = matchMedia('(prefers-color-scheme: dark)');
  const syncTheme = () => {
    const dark = document.documentElement.classList.contains('dark');
    const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
    const tooltip = button?.querySelector('[data-theme-label]');
    if (tooltip) tooltip.textContent = label;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#061624' : '#f6faff');
  };
  let manualPreference = false;
  try { manualPreference = ['light', 'dark'].includes(localStorage.getItem('theme') || ''); } catch { /* Optional persistence. */ }
  button?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    manualPreference = true;
    try { localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch { /* Toggle still works. */ }
    syncTheme();
  });
  preference.addEventListener('change', event => {
    if (!manualPreference) {
      document.documentElement.classList.toggle('dark', event.matches);
      syncTheme();
    }
  });
  syncTheme();

  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-nav-details]'));
  menus.forEach(menu => menu.addEventListener('toggle', () => {
    if (menu.open) menus.filter(other => other !== menu).forEach(other => { other.open = false; });
    if (menu.classList.contains('mobile-navigation')) menu.querySelector('summary')?.setAttribute('aria-label', menu.open ? 'Close navigation' : 'Open navigation');
  }));
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    menus.filter(menu => menu.open).forEach(menu => {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });
  document.addEventListener('click', event => {
    if (!(event.target instanceof Node)) return;
    for (const menu of menus) if (menu.open && !menu.contains(event.target)) menu.open = false;
  });
</script>
