---
import { resumeProjects } from '../data/publicResume';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<section class="resume-section" aria-labelledby="selected-projects">
  <div class="section-heading">
    <h2 id="selected-projects">Selected AI Research</h2>
    {!compact && <a href="/resume-research">Project details <span aria-hidden="true">&rarr;</span></a>}
  </div>
  <p class="section-note">Independent applied R&amp;D and AI-assisted engineering; not commercial or completed Tribal production deployments.</p>
  {resumeProjects.map(project => (
    <article class="project-entry">
      <h3>{compact ? project.title : <a href={`/resume-research#${project.id}`}>{project.title}</a>}</h3>
      <p>{project.printSummary}</p>
      {'resumeBoundary' in project && <p class="section-note">{project.resumeBoundary}</p>}
    </article>
  ))}
  {!compact && <p class="section-note"><a href="/resume-research#inference">Inference &amp; platform engineering <span aria-hidden="true">&rarr;</span></a></p>}
</section>
